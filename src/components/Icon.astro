---
// Iconos Lucide (licencia ISC) renderizados en el servidor: cero JS en el cliente.
import * as lucide from 'lucide-static';

interface Props { name: string; class?: string; label?: string; size?: number }
const { name, class: cls = 'ico', label, size } = Astro.props;

const custom: Record<string, string> = {
  Tooth: '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M7 3c-2.2 0-4 1.8-4 4.5 0 2 .8 3.4 1.5 4.8.6 1.3.9 3 1.2 5 .3 2.2.9 3.7 2 3.7 1.3 0 1.5-2.2 2-4 .3-1.2.9-2 2.3-2s2 .8 2.3 2c.5 1.8.7 4 2 4 1.1 0 1.7-1.5 2-3.7.3-2 .6-3.7 1.2-5 .7-1.4 1.5-2.8 1.5-4.8C21 4.8 19.2 3 17 3c-1.8 0-3 1-5 1S8.8 3 7 3z"/></svg>',
};
let svg = custom[name] ?? (lucide as Record<string, string>)[name];
if (!svg) throw new Error(`Icono no encontrado: ${name}`);
svg = svg
  .replace(/\s(width|height)="24"/g, '')
  .replace(/class="[^"]*"/, '')
  .replace('<svg', `<svg aria-hidden="true" focusable="false"`);
const style = size ? `width:${size}px;height:${size}px` : undefined;
---
<span class={cls} style={style} role={label ? 'img' : undefined} aria-label={label} set:html={svg} />
