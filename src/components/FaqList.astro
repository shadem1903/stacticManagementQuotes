---
interface Props { items: { q: string; a: string }[] }
const { items } = Astro.props;
---
<div class="faq" data-faq data-reveal>
  {items.map((f) => (
    <details>
      <summary><span>{f.q}</span><span class="pm" aria-hidden="true"></span></summary>
      <div class="ans"><p>{f.a}</p></div>
    </details>
  ))}
</div>
<style>
  .faq { border-top: 1px solid var(--line); max-width: 820px; }
  details { border-bottom: 1px solid var(--line); }
  summary {
    list-style: none; cursor: pointer; display: flex; justify-content: space-between; gap: var(--s-6); align-items: center;
    min-height: 64px; padding: var(--s-4) var(--s-2) var(--s-4) 0; font-weight: 600; font-size: var(--t-md); color: var(--ink);
    border-radius: var(--r-sm); transition: color var(--dur-2) var(--ease-out);
  }
  summary::-webkit-details-marker { display: none; }
  summary:hover { color: var(--c-brand); }
  .pm { position: relative; width: 28px; height: 28px; flex: none; border-radius: 50%; border: 1px solid var(--line-strong);
    transition: transform var(--dur-3) var(--ease-out), background-color var(--dur-2), border-color var(--dur-2); }
  .pm::before, .pm::after { content: ''; position: absolute; left: 8px; right: 8px; top: 13px; height: 2px; background: currentColor; border-radius: 2px; transition: transform var(--dur-3) var(--ease-out); }
  .pm::after { transform: rotate(90deg); }
  details[open] .pm { transform: rotate(180deg); background: var(--c-brand-soft); border-color: var(--c-brand); }
  details[open] .pm::after { transform: rotate(0); }
  .ans { color: var(--ink-2); overflow: hidden; }
  .ans p { margin: 0; padding: 0 0 var(--s-5); max-width: 68ch; }
</style>
<script>
  // Acordeón con altura animada. Sin JS, <details> funciona igual sin animación.
  const reduce = window.matchMedia('(prefers-reduced-motion: reduce)');
  document.querySelectorAll<HTMLElement>('[data-faq] details').forEach((d) => {
    const summary = d.querySelector('summary')!;
    const ans = d.querySelector<HTMLElement>('.ans')!;
    let anim: Animation | null = null;
    summary.addEventListener('click', (e) => {
      if (reduce.matches) return;
      e.preventDefault();
      anim?.cancel();
      const opts = { duration: 320, easing: 'cubic-bezier(.2,.8,.2,1)' };
      if (!d.open) {
        d.open = true;
        const h = ans.scrollHeight;
        anim = ans.animate([{ height: '0px', opacity: 0 }, { height: `${h}px`, opacity: 1 }], opts);
      } else {
        const h = ans.scrollHeight;
        anim = ans.animate([{ height: `${h}px`, opacity: 1 }, { height: '0px', opacity: 0 }], { ...opts, duration: 240 });
        anim.onfinish = () => { d.open = false; };
      }
    });
  });
</script>
