---
// App del paciente (Cumplido Salud). Datos de ejemplo.
---
<div class="ph-wrap" aria-hidden="true">
  <div class="phone">
    <div class="scr">
      <div class="notch"><span></span></div>
      <div class="pb">
        <small>Hola, Jorge</small>
        <b class="t">Tu próxima cita</b>
        <div class="next"><small>Fisioterapia · Andrés M.</small><b>Lun 3 nov, 7:30</b><div class="act"><span class="ok">Confirmar</span><span>Cambiar</span></div></div>
        <span class="lb">Tu tratamiento</span>
        <div class="box"><div class="r"><span>Rehabilitación de rodilla</span><b>4/10</b></div><span class="m"><span></span></span></div>
        <span class="lb">Pagos</span>
        <div class="box r"><span>Saldo pendiente</span><b>$ 420.000</b></div>
      </div>
    </div>
  </div>
</div>
<style>
  .ph-wrap { display: flex; justify-content: center; }
  .phone { width: 250px; border-radius: 40px; background: #0b1220; padding: 10px; box-shadow: 0 40px 70px -30px rgb(0 0 0 / 50%); animation: float 6s ease-in-out infinite; }
  .scr { border-radius: 31px; background: #fff; overflow: hidden; min-height: 470px; color: #172b4d; }
  .notch { height: 26px; display: grid; place-items: center; } .notch span { width: 70px; height: 7px; border-radius: 9px; background: #0b1220; }
  .pb { padding: 8px 16px 18px; font-size: 12px; }
  .pb small { display: block; font-size: 11px; color: #5e6c84; }
  .t { display: block; font-size: 18px; font-weight: 800; letter-spacing: -.4px; margin: 2px 0 14px; }
  .next { background: #0b4a91; color: #fff; border-radius: 16px; padding: 14px; }
  .next small { color: rgb(255 255 255 / 80%); } .next b { display: block; font-size: 20px; font-weight: 800; margin-top: 4px; }
  .act { display: flex; gap: 6px; margin-top: 12px; } .act span { flex: 1; border: 1px solid rgb(255 255 255 / 50%); border-radius: 9px; text-align: center; font-size: 11.5px; font-weight: 600; padding: 8px 0; }
  .act .ok { background: #fff; color: #0b4a91; border-color: #fff; font-weight: 700; }
  .lb { display: block; font-size: 12px; font-weight: 700; margin: 16px 0 8px; }
  .box { border: 1px solid #e3eaf3; border-radius: 12px; padding: 12px; }
  .r { display: flex; justify-content: space-between; gap: 8px; }
  .m { display: block; height: 6px; border-radius: 9px; background: #eaf4ff; margin-top: 8px; overflow: hidden; }
  .m span { display: block; width: 40%; height: 100%; background: #00a887; border-radius: inherit; }
  @keyframes float { 0%, 100% { transform: translateY(0); } 50% { transform: translateY(-8px); } }
</style>
