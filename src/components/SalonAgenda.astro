---
// Agenda de un salón con cuatro profesionales (Cumplido Belleza). Datos de ejemplo.
import Icon from './Icon.astro';
const pros = [['CT', 'Camila T.', 'Estilista', 'b'], ['KR', 'Kevin R.', 'Barbero', 'n'], ['LP', 'Luisa P.', 'Manicurista', 'v'], ['DM', 'Daniela M.', 'Estilista', 'h']] as const;
const hours = [['9:00', 1], ['10:00', 3], ['11:00', 5], ['12:00', 7], ['1:00', 9]] as const;
const ap = [
  [2, 1, 5, 'Valentina C.', 'Color y tratamiento'], [3, 1, 2, 'Andrés G.', 'Corte'], [3, 2, 4, 'Daniel S.', 'Barba y corte'],
  [4, 1, 3, 'Mariana F.', 'Semipermanente'], [5, 2, 4, 'Sofía L.', 'Corte y peinado'], [3, 5, 6, 'Felipe M.', 'Cejas'],
  [4, 4, 7, 'Paola D.', 'Pedicure spa'], [2, 6, 9, 'Laura R.', 'Keratina'], [5, 6, 8, 'Carolina V.', 'Peinado evento'],
] as const;
---
<div class="sa-wrap" aria-hidden="true">
  <div class="sa">
    <div class="hd"><div><b>Agenda del salón</b><small>Sábado 1 de noviembre</small></div><div class="vw"><span class="on">Día</span><span>Semana</span></div></div>
    <div class="bd">
      <div class="cols"><span></span>{pros.map(([i, n, r, c]) => <span class="p"><span class={`av av-${c}`}>{i}</span><span class="pn"><b>{n}</b><small>{r}</small></span></span>)}</div>
      <div class="grid">
        {hours.map(([l, r]) => <span class="hr" style={`grid-row:${r}`}>{l}</span>)}
        {ap.map(([c, s, e, w, t], i) => <div class="ap" style={`grid-column:${c};grid-row:${s}/${e};--i:${i}`}><b>{w}</b><span>{t}</span></div>)}
      </div>
    </div>
  </div>
  <div class="float"><span class="fi"><Icon name="Wallet" /></span><span><b>Comisión sumada</b><small>Camila T. · color, $ 54.000</small></span></div>
</div>
<style>
  .sa-wrap { position: relative; }
  .sa { background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); box-shadow: 0 40px 80px -36px rgb(120 10 70 / 35%); overflow: hidden; animation: up 800ms var(--ease-out) 150ms both; }
  .hd { padding: 16px 20px; border-bottom: 1px solid var(--line); display: flex; justify-content: space-between; align-items: center; gap: 12px; }
  .hd b { display: block; font-size: 16px; } .hd small { font-size: 12.5px; color: var(--ink-3); }
  .vw { display: flex; gap: 6px; font-size: 12px; font-weight: 600; } .vw span { padding: 6px 10px; border-radius: var(--r-sm); border: 1px solid var(--line); color: var(--ink-2); }
  .vw .on { background: #fde7f2; color: #b0156a; border-color: transparent; }
  .bd { padding: 14px 20px 20px; }
  .cols, .grid { display: grid; grid-template-columns: 40px repeat(4, minmax(0, 1fr)); column-gap: 8px; }
  .cols { font-size: 12px; }
  .p { display: flex; gap: 6px; align-items: center; padding-bottom: 8px; border-bottom: 1px solid var(--line); min-width: 0; }
  .pn { min-width: 0; } .pn b { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .pn small { color: var(--ink-3); font-size: 11px; }
  .av { width: 26px; height: 26px; border-radius: 50%; display: grid; place-items: center; font-size: 10px; font-weight: 800; flex: none; }
  .av-b { background: #fde7f2; color: #b0156a; } .av-n { background: #eaf4ff; color: #0b4a91; } .av-v { background: #efeafb; color: #5530b0; } .av-h { background: #e3f7f2; color: #00745d; }
  .grid { grid-template-rows: repeat(10, 30px); margin-top: 6px; background-image: linear-gradient(var(--line) 1px, transparent 1px); background-size: 100% 60px; }
  .hr { grid-column: 1; font-size: 11px; color: var(--ink-3); transform: translateY(-6px); }
  .ap { margin: 2px 0; padding: 5px 8px; border-radius: 8px; background: #fde7f2; border-left: 3px solid #d91b83; min-width: 0; overflow: hidden; font-size: 11.5px; line-height: 1.3; color: #172b4d; animation: drop 560ms var(--ease-spring) both; animation-delay: calc(600ms + var(--i) * 90ms); }
  .ap b, .ap span { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .ap span { color: #44546f; }
  .float { position: absolute; right: -20px; top: -24px; background: var(--surface); border: 1px solid var(--line); border-radius: 14px; padding: 12px 14px; display: flex; gap: 10px; align-items: center; box-shadow: var(--shadow-3); font-size: 12.5px; animation: pop 700ms var(--ease-spring) 1.6s both; }
  .float b { display: block; } .float small { color: var(--ink-3); font-size: 12px; }
  .fi { width: 34px; height: 34px; border-radius: 10px; background: #fde7f2; color: #b0156a; display: grid; place-items: center; }
  .fi :global(.ico) { width: 18px; height: 18px; }
  @keyframes up { from { opacity: 0; transform: translateY(24px); } to { opacity: 1; transform: none; } }
  @keyframes pop { from { opacity: 0; transform: translateY(14px) scale(.92); } to { opacity: 1; transform: none; } }
  @keyframes drop { from { opacity: 0; transform: translateY(-10px) scale(.95); } to { opacity: 1; transform: none; } }
  @media (max-width: 640px) { .ap span, .pn small { display: none; } .float { right: 8px; top: auto; bottom: -30px; } .bd { padding: 12px; } .cols, .grid { grid-template-columns: 30px repeat(4, minmax(0, 1fr)); column-gap: 4px; } }
</style>
