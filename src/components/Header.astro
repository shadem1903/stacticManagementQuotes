---
import Logo from './Logo.astro';
import Icon from './Icon.astro';
import { portalUrl } from '../lib/company';
import { solutionList } from '../data/solutions';

const path = Astro.url.pathname.replace(/\.html$/, '').replace(/\/$/, '') || '/';
const isActive = (href: string) => (href === '/' ? path === '/' : path === href || path.startsWith(href + '/'));
const links = [
  { href: '/funcionalidades', label: 'Funcionalidades' },
  { href: '/planes', label: 'Planes' },
  { href: '/promociones', label: 'Promociones' },
  { href: '/contacto', label: 'Contacto' },
];
---
<header class="site-header" data-header>
  <div class="wrap bar">
    <a href="/" class="brand" aria-label="Inicio"><Logo /></a>

    <nav class="nav" aria-label="Principal" id="main-nav" data-nav>
      <ul class="nav-list">
        {solutionList.map((sol) => (
          <li>
            <a class="nav-link prod-link" href={`/soluciones/${sol.id}`} style={`--accent:${sol.accent}`} aria-current={isActive(`/soluciones/${sol.id}`) ? 'page' : undefined}>
              <span class="prod-dot" aria-hidden="true"></span>{sol.name}
            </a>
          </li>
        ))}
        {links.map((l) => (
          <li><a class="nav-link" href={l.href} aria-current={isActive(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
      </ul>
      <div class="nav-actions">
        {portalUrl && <a class="btn btn--ghost btn--sm" href={portalUrl} rel="noopener">Acceso clientes</a>}
        <a class="btn btn--sm" href="/contacto?motivo=demo">Solicitar demostración</a>
      </div>
    </nav>

    <div class="bar-end">
      <button class="icon-btn" type="button" data-theme-toggle aria-label="Cambiar a tema oscuro">
        <Icon name="Moon" class="ico i-moon" /><Icon name="Sun" class="ico i-sun" />
      </button>
      <button class="icon-btn menu-btn" type="button" aria-expanded="false" aria-controls="main-nav" data-menu-toggle>
        <span class="sr-only" data-menu-label>Abrir menú</span>
        <Icon name="Menu" class="ico i-open" /><Icon name="X" class="ico i-close" />
      </button>
    </div>
  </div>
</header>

<style>
  /* Sin backdrop-filter: además de estar en la lista de prohibidos, convertía al encabezado
     en contenedor de los elementos fijos y dejaba el menú móvil con 65 px de alto. */
  .site-header {
    position: sticky; top: 0; z-index: 50; height: var(--header-h);
    background: var(--bg); border-bottom: 1px solid var(--line);
    transition: box-shadow var(--dur-3) var(--ease-out);
  }
  .site-header.is-scrolled { box-shadow: 0 6px 20px -14px rgb(7 59 120 / 35%); }
  .bar { height: 100%; display: flex; align-items: center; gap: var(--s-5); }
  .brand { text-decoration: none; flex: none; border-radius: var(--r-md); }
  .brand :global(.logo-mark) { transition: transform var(--dur-3) var(--ease-spring); }
  .brand:hover :global(.logo-mark) { transform: rotate(-8deg) scale(1.05); }
  .nav { display: flex; align-items: center; gap: var(--s-4); flex: 1; justify-content: space-between; }
  .nav-list { list-style: none; display: flex; gap: 2px; align-items: center; }
  .nav-link {
    position: relative; display: inline-flex; align-items: center; gap: 4px; min-height: 44px; padding: 0 10px; border-radius: var(--r-sm); white-space: nowrap;
    color: var(--ink-2); font: 500 var(--t-sm)/1.2 var(--font); text-decoration: none; background: none; border: 0; cursor: pointer;
    transition: color var(--dur-2) var(--ease-out), background-color var(--dur-2) var(--ease-out);
  }
  .nav-link::after {
    content: ''; position: absolute; left: 10px; right: 10px; bottom: 6px; height: 2px; border-radius: 2px;
    background: var(--accent, var(--c-brand)); transform: scaleX(0); transform-origin: left; transition: transform var(--dur-3) var(--ease-out);
  }
  .nav-link:hover { color: var(--ink); }
  .nav-link:hover::after, .nav-link[aria-current='page']::after { transform: scaleX(1); }
  .nav-link[aria-current='page'] { color: var(--ink); font-weight: 600; }
  .nav-actions { display: flex; gap: var(--s-2); align-items: center; white-space: nowrap; }
  .bar-end { display: flex; gap: var(--s-2); align-items: center; }
  .icon-btn {
    position: relative; width: 44px; height: 44px; display: grid; place-items: center; border-radius: var(--r-md);
    border: 1px solid var(--line); background: var(--surface); color: var(--ink-2); cursor: pointer;
    transition: color var(--dur-2), border-color var(--dur-2), transform var(--dur-1) var(--ease-out);
  }
  .icon-btn:hover { color: var(--ink); border-color: var(--line-strong); }
  .icon-btn:active { transform: scale(.94); }
  .icon-btn :global(.ico) { position: absolute; width: 20px; height: 20px; transition: transform var(--dur-3) var(--ease-spring), opacity var(--dur-2); }
  /* Iconos que giran al cambiar de estado */
  :global(.i-sun), :global(.i-close) { opacity: 0; transform: rotate(-90deg) scale(.6); }
  :global(:root[data-theme-resolved='dark']) :global(.i-sun) { opacity: 1; transform: none; }
  :global(:root[data-theme-resolved='dark']) :global(.i-moon) { opacity: 0; transform: rotate(90deg) scale(.6); }
  .menu-btn[aria-expanded='true'] :global(.i-close) { opacity: 1; transform: none; }
  .menu-btn[aria-expanded='true'] :global(.i-open) { opacity: 0; transform: rotate(90deg) scale(.6); }
  .menu-btn { display: none; }

  .prod-link { font-weight: 600; color: var(--ink); }
  .prod-dot { width: 8px; height: 8px; border-radius: 50%; background: var(--accent); margin-right: 4px; transition: transform var(--dur-3) var(--ease-spring); }
  .prod-link:hover .prod-dot { transform: scale(1.4); }

  .scrim { display: none; }

  @media (max-width: 1140px) {
    .menu-btn { display: grid; }
    .bar { justify-content: space-between; }
    .nav {
      position: fixed; top: var(--header-h); left: 0; right: 0; bottom: 0; z-index: 49;
      flex-direction: column; align-items: stretch; justify-content: flex-start;
      gap: var(--s-6); padding: var(--s-4) var(--s-4) calc(var(--s-10) + env(safe-area-inset-bottom)); overflow-y: auto; overscroll-behavior: contain;
      background: var(--bg);
      visibility: hidden; clip-path: inset(0 0 100% 0);
      transition: clip-path var(--dur-3) var(--ease-in-out), visibility 0s linear var(--dur-3);
    }
    .nav.is-open { visibility: visible; clip-path: inset(0 0 0 0); transition: clip-path var(--dur-3) var(--ease-out), visibility 0s; }
    .nav-list { flex-direction: column; align-items: stretch; gap: 0; }
    .nav-list li, .nav-actions { opacity: 0; transform: translateY(-8px); transition: opacity var(--dur-2), transform var(--dur-3) var(--ease-out); }
    .nav.is-open .nav-list li, .nav.is-open .nav-actions { opacity: 1; transform: none; transition-delay: calc(60ms + var(--i, 0) * 35ms); }
    .nav-link { width: 100%; justify-content: flex-start; min-height: 56px; padding: 0 8px; font-size: var(--t-md); border-bottom: 1px solid var(--line); border-radius: 0; }
    .nav-link::after { display: none; }
    .nav-link[aria-current='page'] { color: var(--c-brand); }
    .nav-actions { flex-direction: column; align-items: stretch; }
    .nav-actions .btn { min-height: 52px; font-size: var(--t-base); }
    .prod-link { gap: 8px; }
  }
</style>

<script>
  const header = document.querySelector<HTMLElement>('[data-header]')!;
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const menuBtn = document.querySelector<HTMLButtonElement>('[data-menu-toggle]')!;
  const menuLabel = document.querySelector<HTMLElement>('[data-menu-label]')!;
  const onScroll = () => header.classList.toggle('is-scrolled', window.scrollY > 4);
  onScroll();
  window.addEventListener('scroll', onScroll, { passive: true });

  // Escalonado de los elementos del menú móvil
  nav.querySelectorAll<HTMLElement>('.nav-list li, .nav-actions').forEach((el, i) => el.style.setProperty('--i', String(i)));

  const outside = () => [document.querySelector('main'), document.querySelector('footer'), document.querySelector('.skip-link')] as (HTMLElement | null)[];
  const focusables = () => [menuBtn, ...nav.querySelectorAll<HTMLElement>('a[href], button:not([disabled])')];
  const setMenu = (open: boolean) => {
    menuBtn.setAttribute('aria-expanded', String(open));
    menuLabel.textContent = open ? 'Cerrar menú' : 'Abrir menú';
    nav.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    outside().forEach((el) => el && (el.inert = open));
    if (open) setTimeout(() => nav.querySelector<HTMLElement>('a, button')?.focus(), 60);
  };
  menuBtn.addEventListener('click', () => setMenu(menuBtn.getAttribute('aria-expanded') !== 'true'));
  nav.addEventListener('click', (e) => { if ((e.target as HTMLElement).closest('a')) setMenu(false); });
  document.addEventListener('keydown', (e) => {
    if (!nav.classList.contains('is-open')) return;
    if (e.key === 'Escape') { setMenu(false); menuBtn.focus(); return; }
    if (e.key === 'Tab') {
      // Mantiene el foco dentro del menú abierto
      const f = focusables();
      const i = f.indexOf(document.activeElement as HTMLElement);
      if (e.shiftKey && i <= 0) { e.preventDefault(); f[f.length - 1].focus(); }
      else if (!e.shiftKey && i === f.length - 1) { e.preventDefault(); f[0].focus(); }
    }
  });
  window.matchMedia('(min-width: 1141px)').addEventListener('change', (m) => { if (m.matches) setMenu(false); });

  // Tema claro/oscuro: preferencia guardada solo en este navegador (sin cookies).
  const themeBtn = document.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const root = document.documentElement;
  const syncLabel = () => {
    const dark = root.dataset.themeResolved === 'dark';
    themeBtn.setAttribute('aria-label', dark ? 'Cambiar a tema claro' : 'Cambiar a tema oscuro');
  };
  syncLabel();
  themeBtn.addEventListener('click', () => {
    const next = root.dataset.themeResolved === 'dark' ? 'light' : 'dark';
    root.classList.add('theme-anim');
    root.dataset.theme = next;
    root.dataset.themeResolved = next;
    try { localStorage.setItem('theme', next); } catch {}
    syncLabel();
    setTimeout(() => root.classList.remove('theme-anim'), 400);
  });
</script>
