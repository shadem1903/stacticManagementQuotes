---
// Composición del hero: software de escritorio + app del paciente + notificación.
// Pantallas ilustrativas con datos de ejemplo (el producto está en desarrollo).
const H = 'var(--c-health)';
const hours = [['8:00', 1], ['9:00', 3], ['10:00', 5], ['11:00', 7]] as const;
const appts = [
  [2, 1, 3, 'Laura G.', 'Control ortodoncia'], [3, 1, 2, 'Pedro N.', 'Limpieza'], [4, 2, 4, 'Jorge P.', 'Sesión 4 de 10'],
  [3, 3, 6, 'Sara M.', 'Endodoncia'], [2, 5, 7, 'Mateo R.', 'Resina'], [4, 5, 7, 'Ana V.', 'Valoración'], [3, 7, 9, 'Elena C.', 'Control'],
] as const;
const days = [['LUN', 3], ['MAR', 4], ['MIÉ', 5], ['JUE', 6], ['VIE', 7]] as const;
const slots = [['8:00', ''], ['9:00', 'off'], ['10:30', 'on'], ['11:00', ''], ['2:00', ''], ['3:30', '']] as const;
const side = ['Agenda', 'Pacientes', 'Historia clínica', 'Tratamientos', 'Inventario', 'Caja', 'Contabilidad', 'Reportes'];
---
<div class="show" data-parallax aria-hidden="true">
  <div class="win layer" style="--depth: 6">
    <div class="bar"><i></i><i></i><i></i><span class="url">app.cumplido.co/agenda</span></div>
    <div class="body">
      <div class="side">
        <div class="clinic"><span class="mini"><svg viewBox="0 0 48 48"><path d="M32.4 16.9A11 11 0 1 0 32.4 31.1" fill="none" stroke="#fff" stroke-width="6" stroke-linecap="round"/><path d="M18.5 24.2l4.6 4.6L37 14.6" fill="none" stroke="#5FE0C3" stroke-width="6" stroke-linecap="round"/></svg></span><strong>Clínica Dental Sonría</strong></div>
        {side.map((s, i) => <span class:list={['nav', { on: i === 0 }]}>{s}</span>)}
      </div>
      <div class="main">
        <div class="top"><div><b>Agenda</b><small>Jueves 29 de octubre</small></div><span class="new">Nueva cita</span></div>
        <div class="kpis">
          <div><small>Citas hoy</small><b data-count="24">24</b><em class="ok">3 por confirmar</em></div>
          <div><small>Caja del día</small><b data-count="1840000" data-prefix="$ ">$ 1.840.000</b><em>12 pagos registrados</em></div>
          <div><small>Ocupación</small><b data-count="82" data-suffix="%">82%</b><span class="meter"><span></span></span></div>
        </div>
        <div class="cols"><span></span><span><i></i>Dra. Paula R.</span><span><i></i>Dr. Julián O.</span><span><i></i>Andrés M.</span></div>
        <div class="grid">
          {hours.map(([l, r]) => <span class="hr" style={`grid-row:${r}`}>{l}</span>)}
          {appts.map(([c, s, e, who, what], i) => (
            <div class="ap" style={`grid-column:${c};grid-row:${s}/${e};--i:${i}`}><b>{who}</b><span>{what}</span></div>
          ))}
          <div class="now"><span></span></div>
        </div>
      </div>
    </div>
  </div>

  <div class="phone layer" style="--depth: 16">
    <div class="screen">
      <div class="notch"><span></span></div>
      <div class="pbody">
        <small>Clínica Dental Sonría</small>
        <b class="ptitle">Reserva tu cita</b>
        <small class="lbl">Noviembre</small>
        <div class="days">{days.map(([d, n], i) => <span class:list={{ on: i === 2 }}><em>{d}</em><b>{n}</b></span>)}</div>
        <small class="lbl">Horarios con Dra. Paula R.</small>
        <div class="slots">{slots.map(([t, st]) => <span class={st}>{t}</span>)}</div>
        <span class="confirm">Confirmar cita</span>
      </div>
    </div>
  </div>

  <div class="toast layer" style="--depth: 24">
    <span class="tic"><svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M6 8a6 6 0 0 1 12 0c0 7 3 9 3 9H3s3-2 3-9"/><path d="M10.3 21a1.94 1.94 0 0 0 3.4 0"/></svg></span>
    <span><b>Recordatorio enviado</b><small>Laura G. confirmó su cita de mañana, 8:00</small></span>
  </div>
</div>

<style>
  .show { position: relative; padding: 0 0 48px; --mx: 0; --my: 0; color: #172b4d; }
  .layer { translate: calc(var(--mx) * var(--depth) * 1px) calc(var(--my) * var(--depth) * 1px); transition: translate 600ms var(--ease-out); }

  /* Ventana de escritorio */
  .win { background: #fff; border-radius: 16px; overflow: hidden; box-shadow: 0 40px 80px -24px rgb(0 0 0 / 60%), 0 0 0 1px rgb(255 255 255 / 8%); animation: winIn 900ms var(--ease-out) 120ms both; }
  .bar { height: 34px; background: #eef2f8; display: flex; align-items: center; gap: 7px; padding: 0 14px; border-bottom: 1px solid #d9e2ef; }
  .bar i { width: 11px; height: 11px; border-radius: 50%; background: #f26b5b; }
  .bar i:nth-child(2) { background: #f5be4f; } .bar i:nth-child(3) { background: #5cc46a; }
  .url { margin-left: 14px; flex: 1; max-width: 280px; height: 21px; border-radius: 6px; background: #fff; border: 1px solid #d9e2ef; font-size: 11px; color: #5e6c84; display: flex; align-items: center; padding: 0 10px; }
  .body { display: flex; min-height: 420px; }
  .side { width: 160px; flex: none; background: #f8fafd; border-right: 1px solid #d9e2ef; padding: 14px 10px; display: flex; flex-direction: column; gap: 2px; font-size: 12.5px; color: #44546f; }
  .clinic { display: flex; align-items: center; gap: 8px; padding: 4px 6px 14px; font-size: 12.5px; color: #172b4d; line-height: 1.2; }
  .mini { width: 24px; height: 24px; border-radius: 7px; background: #0b4a91; display: grid; place-items: center; flex: none; }
  .mini svg { width: 14px; height: 14px; }
  .nav { padding: 7px 10px; border-radius: 8px; }
  .nav.on { background: #eaf4ff; color: #0b4a91; font-weight: 600; }
  .main { flex: 1; min-width: 0; padding: 14px 16px; }
  .top { display: flex; justify-content: space-between; align-items: center; }
  .top b { display: block; font-size: 16px; } .top small { font-size: 11.5px; color: #5e6c84; }
  .new { font-size: 11.5px; font-weight: 600; background: #0b4a91; color: #fff; padding: 7px 11px; border-radius: 8px; }
  .kpis { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 10px; margin: 14px 0; }
  .kpis > div { border: 1px solid #d9e2ef; border-radius: 10px; padding: 9px 10px; min-width: 0; }
  .kpis small { display: block; font-size: 10.5px; color: #5e6c84; }
  .kpis b { display: block; font-size: 19px; font-weight: 800; letter-spacing: -.5px; font-variant-numeric: tabular-nums; white-space: nowrap; }
  .kpis em { font-style: normal; font-size: 10px; color: #5e6c84; } .kpis em.ok { color: #00745d; font-weight: 600; }
  .meter { display: block; height: 5px; border-radius: 9px; background: #eaf4ff; margin-top: 6px; overflow: hidden; }
  .meter span { display: block; width: 82%; height: 100%; background: #6339c8; border-radius: inherit; transform-origin: left; animation: fill 1.1s var(--ease-out) 900ms both; }
  .cols { display: grid; grid-template-columns: 34px repeat(3, minmax(0, 1fr)); column-gap: 6px; font-size: 10.5px; font-weight: 650; }
  .cols span:not(:first-child) { padding-bottom: 6px; border-bottom: 1px solid #d9e2ef; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; }
  .cols i { display: inline-block; width: 7px; height: 7px; border-radius: 50%; background: #00a887; margin-right: 5px; }
  .grid { position: relative; display: grid; grid-template-columns: 34px repeat(3, minmax(0, 1fr)); grid-template-rows: repeat(8, 28px); column-gap: 6px; margin-top: 4px; background-image: linear-gradient(#e6ecf5 1px, transparent 1px); background-size: 100% 56px; }
  .hr { grid-column: 1; font-size: 10px; color: #5e6c84; transform: translateY(-6px); }
  .ap { margin: 2px 0; padding: 4px 7px; border-radius: 7px; background: #e3f7f2; border-left: 3px solid #00a887; min-width: 0; overflow: hidden; font-size: 10.5px; line-height: 1.3; animation: drop 600ms var(--ease-spring) both; animation-delay: calc(700ms + var(--i) * 110ms); }
  .ap b, .ap span { display: block; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; } .ap span { color: #44546f; }
  .now { position: absolute; left: 40px; right: 0; top: 0; border-top: 2px solid #d91b83; animation: now 2.4s var(--ease-out) 1.6s both; }
  .now span { position: absolute; left: -5px; top: -6px; width: 10px; height: 10px; border-radius: 50%; background: #d91b83; }

  /* Teléfono */
  .phone { position: absolute; right: -16px; bottom: -6px; width: 214px; border-radius: 34px; background: #0b1220; padding: 9px; box-shadow: 0 34px 60px -18px rgb(0 0 0 / 70%); animation: phoneIn 900ms var(--ease-out) 900ms both; }
  .screen { border-radius: 26px; background: #fff; overflow: hidden; }
  .notch { height: 22px; display: grid; place-items: center; } .notch span { width: 64px; height: 6px; border-radius: 9px; background: #0b1220; }
  .pbody { padding: 4px 14px 14px; font-size: 10px; }
  .pbody small { display: block; color: #5e6c84; font-size: 10px; }
  .ptitle { display: block; font-size: 15px; font-weight: 800; margin: 2px 0 10px; letter-spacing: -.3px; }
  .lbl { font-weight: 600; color: #44546f !important; margin: 10px 0 6px; }
  .days { display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: 4px; text-align: center; }
  .days span { border-radius: 9px; padding: 5px 0; background: #f1f5fa; }
  .days span.on { background: #0b4a91; color: #fff; animation: pick 500ms var(--ease-spring) 1.9s both; }
  .days em { display: block; font-style: normal; font-size: 8.5px; opacity: .75; } .days b { font-size: 12px; }
  .slots { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 5px; text-align: center; font-size: 10.5px; }
  .slots span { border: 1px solid #d9e2ef; border-radius: 8px; padding: 6px 0; }
  .slots .off { color: #9aa6b8; text-decoration: line-through; }
  .slots .on { border: 1.5px solid #00a887; background: #e3f7f2; color: #00745d; font-weight: 700; animation: pick 500ms var(--ease-spring) 2.2s both; }
  .confirm { display: block; margin-top: 12px; background: #0b4a91; color: #fff; border-radius: 10px; text-align: center; font-size: 11.5px; font-weight: 700; padding: 10px 0; }

  /* Notificación */
  .toast { position: absolute; left: -22px; bottom: 54px; width: 238px; background: #fff; border-radius: 14px; padding: 12px 14px; display: flex; gap: 10px; align-items: center; box-shadow: 0 24px 40px -16px rgb(0 0 0 / 55%); font-size: 12px; line-height: 1.35; animation: toastIn 700ms var(--ease-spring) 2.5s both; }
  .toast b { display: block; font-size: 12.5px; } .toast small { color: #5e6c84; font-size: 12px; }
  .tic { width: 34px; height: 34px; border-radius: 10px; background: #e3f7f2; color: #00745d; display: grid; place-items: center; flex: none; }
  .tic svg { width: 18px; height: 18px; animation: ring 1s ease-in-out 3.1s 2; transform-origin: 50% 10%; }

  @keyframes winIn { from { opacity: 0; transform: translateY(28px) scale(.97); } to { opacity: 1; transform: none; } }
  @keyframes phoneIn { from { opacity: 0; transform: translate(40px, 30px) rotate(6deg); } to { opacity: 1; transform: none; } }
  @keyframes toastIn { from { opacity: 0; transform: translateY(16px) scale(.9); } to { opacity: 1; transform: none; } }
  @keyframes drop { from { opacity: 0; transform: translateY(-10px) scale(.95); } to { opacity: 1; transform: none; } }
  @keyframes now { from { top: 0; opacity: 0; } 15% { opacity: 1; } to { top: 132px; opacity: 1; } }
  @keyframes fill { from { transform: scaleX(0); } to { transform: scaleX(1); } }
  @keyframes pick { 0% { transform: scale(1); } 50% { transform: scale(1.12); } 100% { transform: scale(1); } }
  @keyframes ring { 0%, 100% { transform: rotate(0); } 20% { transform: rotate(14deg); } 40% { transform: rotate(-12deg); } 60% { transform: rotate(8deg); } 80% { transform: rotate(-4deg); } }

  /* El parallax usa la propiedad translate, que se suma a las animaciones de transform */
  .win, .phone, .toast { will-change: transform, translate; }

  @media (max-width: 760px) {
    .side { display: none; }
    .body { min-height: 0; }
    .phone { width: 168px; right: -6px; bottom: -18px; border-radius: 28px; padding: 7px; }
    .screen { border-radius: 22px; }
    .pbody { padding: 2px 10px 10px; }
    .toast { left: 0; bottom: auto; top: -26px; width: 220px; padding: 10px 12px; }
  }
  @media (max-width: 480px) {
    .kpis { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .kpis > div:last-child { display: none; }
    .ap span { display: none; }
    .phone { display: none; }
  }
</style>

<script>
  // Parallax suave con el cursor (solo con mouse y movimiento permitido)
  const el = document.querySelector<HTMLElement>('[data-parallax]');
  const fine = window.matchMedia('(hover: hover) and (pointer: fine)').matches;
  const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (el && fine && !still) {
    const host = el.closest('section') ?? el;
    let raf = 0;
    host.addEventListener('pointermove', (e) => {
      cancelAnimationFrame(raf);
      raf = requestAnimationFrame(() => {
        const r = host.getBoundingClientRect();
        el.style.setProperty('--mx', String(((e.clientX - r.left) / r.width - 0.5) * -1));
        el.style.setProperty('--my', String(((e.clientY - r.top) / r.height - 0.5) * -1));
      });
    });
    host.addEventListener('pointerleave', () => { el.style.setProperty('--mx', '0'); el.style.setProperty('--my', '0'); });
  }
</script>
