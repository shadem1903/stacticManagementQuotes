---
import '@fontsource-variable/inter';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { company } from '../lib/company';

interface Props {
  title: string;
  description: string;
  noindex?: boolean;
  jsonLd?: Record<string, unknown> | Record<string, unknown>[];
  headerTone?: 'light' | 'dark';
}
const { title, description, noindex = false, jsonLd, headerTone = 'light' } = Astro.props;
const fullTitle = Astro.url.pathname === '/' ? `${company.brandName}: ${title}` : title.startsWith(company.brandName) ? title : `${title} | ${company.brandName}`;
const canonical = Astro.site ? new URL(Astro.url.pathname.replace(/\.html$/, '').replace(/\/index$/, '/'), Astro.site).href : null;
const ogImage = Astro.site ? new URL('/og.png', Astro.site).href : null;
---
<!doctype html>
<html lang="es-CO">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    {noindex && <meta name="robots" content="noindex, follow" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:type" content="website" />
    <meta property="og:locale" content="es_CO" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:site_name" content={company.brandName} />
    {canonical && <meta property="og:url" content={canonical} />}
    {ogImage && <meta property="og:image" content={ogImage} />}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="theme-color" content="#0B4A91" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <script is:inline>
      // Aplica el tema antes de pintar para evitar parpadeo. Preferencia local, sin cookies.
      (function () {
        var r = document.documentElement, t = null;
        r.classList.add('js');
        try { t = localStorage.getItem('theme'); } catch (e) {}
        if (t === 'light' || t === 'dark') r.dataset.theme = t;
        var dark = t ? t === 'dark' : window.matchMedia('(prefers-color-scheme: dark)').matches;
        r.dataset.themeResolved = dark ? 'dark' : 'light';
      })();
    </script>
    {jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
  </head>
  <body>
    <a class="skip-link" href="#contenido">Saltar al contenido</a>
    <Header tone={headerTone} />
    <main id="contenido" tabindex="-1">
      <slot />
    </main>
    <Footer />
    <script>
      // Revelado progresivo: cada bloque con data-reveal anima a sus hijos en cascada al entrar en pantalla.
      const groups = document.querySelectorAll<HTMLElement>('[data-reveal]');
      groups.forEach((g) => Array.from(g.children).forEach((c, i) => (c as HTMLElement).style.setProperty('--i', String(Math.min(i, 8)))));
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver((entries) => {
          for (const e of entries) if (e.isIntersecting) { e.target.classList.add('is-in'); io.unobserve(e.target); }
        }, { rootMargin: '0px 0px -10% 0px', threshold: 0 });
        groups.forEach((g) => io.observe(g));
      } else {
        groups.forEach((g) => g.classList.add('is-in'));
      }

      // Cifras que cuentan hacia arriba al entrar en pantalla (data-count="1840000" data-prefix="$ " data-suffix="%")
      const counters = document.querySelectorAll<HTMLElement>('[data-count]');
      const fmt = new Intl.NumberFormat('es-CO');
      const still = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
      const paint = (el: HTMLElement, v: number) => { el.textContent = (el.dataset.prefix ?? '') + fmt.format(Math.round(v)) + (el.dataset.suffix ?? ''); };
      const run = (el: HTMLElement) => {
        const target = Number(el.dataset.count);
        if (still) return paint(el, target);
        const t0 = performance.now(), dur = Number(el.dataset.dur ?? 1100);
        const step = (t: number) => { const k = Math.min(1, (t - t0) / dur); paint(el, target * (1 - Math.pow(1 - k, 3))); if (k < 1) requestAnimationFrame(step); };
        requestAnimationFrame(step);
      };
      if ('IntersectionObserver' in window) {
        const co = new IntersectionObserver((entries) => { for (const e of entries) if (e.isIntersecting) { run(e.target as HTMLElement); co.unobserve(e.target); } }, { threshold: 0.4 });
        counters.forEach((c) => co.observe(c));
      }
    </script>
  </body>
</html>
