---
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import HeroShowcase from '../components/HeroShowcase.astro';
import ProductShowcase from '../components/ProductShowcase.astro';
import PhotoPanel from '../components/PhotoPanel.astro';
import DayTimeline from '../components/DayTimeline.astro';
import FinanceCard from '../components/FinanceCard.astro';
import PlanCards from '../components/PlanCards.astro';
import FaqList from '../components/FaqList.astro';
import { solutionList } from '../data/solutions';
import faqs from '../data/faqs.json';
import promoData from '../data/promotions.json';
import { activePromotions, type Promotion } from '../lib/promotions';
import { company, has } from '../lib/company';

const homeFaqs = faqs.categories.flatMap((c) => c.items).filter((f) => 'home' in f && f.home);
const promos = activePromotions(promoData.promotions as Promotion[]);
const adminPoints = ['Cierre de caja diario por método de pago', 'Cartera: quién debe y cuánto', 'Estados financieros del negocio', 'Acceso para tu contador, sin ver historias clínicas'];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: company.brandName, ...(has(company.siteUrl) ? { url: company.siteUrl, logo: new URL('/brand/cumplido-marca.svg', company.siteUrl).href } : {}) },
  ...solutionList.map((s) => ({ '@context': 'https://schema.org', '@type': 'SoftwareApplication', name: s.name, applicationCategory: 'BusinessApplication', operatingSystem: 'Web, Android, iOS', description: s.seoDescription, inLanguage: 'es-CO' })),
];
---
<Base
  title="Software para consultorios y salones de belleza"
  description="Cumplido es el software de gestión para negocios de salud y de belleza en Colombia: Cumplido Salud para consultorios de odontología y fisioterapia, y Cumplido Belleza para peluquerías, barberías y salones. Agenda, atención, administración y contabilidad incluidas."
  jsonLd={jsonLd}
  headerTone="dark"
>
  <!-- Hero -->
  <section class="navy hero">
    <div class="navy-grid" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <div class="copy">
        <p class="flag"><span class="pulse" aria-hidden="true"></span>En desarrollo: pide una demostración</p>
        <h1>Citas a tiempo, clientes que vuelven y cuentas claras.</h1>
        <p class="lead">El software para tu consultorio o tu salón. Agenda, atención, caja y contabilidad en un solo lugar, hecho para cómo trabajas en Colombia.</p>
        <div class="actions">
          <a class="btn btn--light" href="/contacto?motivo=demo">Solicitar demostración</a>
          <a class="btn btn--outline-light" href="#productos">Ver los dos software</a>
        </div>
        <ul class="prods" aria-label="Software">
          {solutionList.map((s) => (
            <li>
              <a href={`/soluciones/${s.id}`} class={`prod prod--${s.id}`}>
                <span class="pi"><Icon name={s.icon} /></span>
                <span><strong>{s.name}</strong><span>{s.audience.slice(0, 2).join(', ')}</span></span>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <div class="visual"><HeroShowcase /></div>
    </div>
    <p class="wrap disclaimer">Pantallas ilustrativas con datos de ejemplo. Cumplido está en desarrollo.</p>
  </section>

  <!-- Dos software -->
  <section class="section" id="productos" aria-labelledby="productos-t">
    <div class="wrap"><ProductShowcase /></div>
  </section>

  <!-- Fotos -->
  <section class="section section--flush" aria-label="Para quién es Cumplido">
    <div class="wrap photos" data-reveal>
      <PhotoPanel tone="salud" eyebrow="Cumplido Salud" title="Más tiempo con tus pacientes, menos con el papeleo." href="/soluciones/salud" />
      <PhotoPanel tone="belleza" eyebrow="Cumplido Belleza" title="Sillas llenas, comisiones claras y clientas que vuelven." href="/soluciones/belleza" />
    </div>
  </section>

  <!-- Un día -->
  <section class="section section--surface" aria-labelledby="dia-t">
    <div class="wrap">
      <div class="section-head">
        <h2 id="dia-t">Una cita, y todo lo demás se hace solo.</h2>
        <p>Lo que pasa en la agenda queda registrado en caja, inventario y contabilidad, sin digitar dos veces.</p>
      </div>
      <DayTimeline />
    </div>
  </section>

  <!-- Administración -->
  <section class="section" aria-labelledby="admin-t">
    <div class="wrap admin">
      <div class="admin-copy">
        <span class="pill">Incluido en los dos</span>
        <h2 id="admin-t">Administración y contabilidad completas. Sin otro programa.</h2>
        <p class="lead">Caja, cartera, gastos, compras, personal y reportes vienen dentro de Cumplido Salud y Cumplido Belleza.</p>
        <ul class="ticks" data-reveal>
          {adminPoints.map((p) => <li><Icon name="Check" />{p}</li>)}
        </ul>
        <a class="link-touch" href="/soluciones/administracion">Ver todo lo que incluye</a>
      </div>
      <div class="admin-visual"><FinanceCard /></div>
    </div>
  </section>

  <!-- Planes -->
  <section class="section section--surface" aria-labelledby="planes-t">
    <div class="wrap">
      <div class="section-head center">
        <h2 id="planes-t">Planes según el tamaño de tu equipo</h2>
        <p>Los mismos planes para los dos software. Suscripción mensual, precio por cotización.</p>
      </div>
      <PlanCards />
      <p class="promo-line small">
        {promos.length > 0
          ? <>Hay {promos.length === 1 ? 'una promoción vigente' : `${promos.length} promociones vigentes`}. <a href="/promociones">Ver condiciones</a></>
          : <>No hay promociones vigentes en este momento. <a href="/promociones">Ver promociones</a></>}
      </p>
    </div>
  </section>

  <!-- Confianza -->
  <section class="section" aria-labelledby="seg-t">
    <div class="wrap">
      <div class="section-head">
        <h2 id="seg-t">Cómo cuidamos tu información</h2>
        <p>Separamos lo que ya aplicamos en este sitio de lo que estamos construyendo en el software. No declaramos certificaciones que no tenemos.</p>
      </div>
      <div class="trust" data-reveal>
        <div class="trust-col">
          <h3><Icon name="Monitor" />En este sitio</h3>
          <ul class="ticks">
            <li><Icon name="Check" />Sin cookies de analítica, publicidad ni herramientas de terceros.</li>
            <li><Icon name="Check" />El formulario pide solo los datos necesarios para responderte.</li>
            <li><Icon name="Check" />Recibir publicidad es opcional y va en una casilla aparte.</li>
            <li><Icon name="Check" />Nunca pedimos información de salud en formularios públicos.</li>
          </ul>
        </div>
        <div class="trust-col">
          <h3><Icon name="ShieldCheck" />En el software (en desarrollo)</h3>
          <ul class="ticks">
            <li><Icon name="Check" />Usuarios con permisos por rol, módulo y función.</li>
            <li><Icon name="Check" />La historia clínica solo la ve quien tiene permiso clínico.</li>
            <li><Icon name="Check" />La información de cada negocio separada de la de los demás.</li>
            <li><Icon name="Check" />Comunicación cifrada y copias de seguridad.</li>
          </ul>
        </div>
      </div>
      <p class="trust-links small">
        <a class="link-touch" href="/legal/seguridad">Seguridad y reporte de incidentes</a>
        <a class="link-touch" href="/legal/tratamiento-de-datos">Tratamiento de datos personales</a>
        <a class="link-touch" href="/legal/tratamiento-por-encargo">Datos de tus pacientes y clientes</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section section--surface" aria-labelledby="faq-t">
    <div class="wrap faq-wrap">
      <div class="section-head">
        <h2 id="faq-t">Preguntas frecuentes</h2>
        <p>¿No encuentras tu pregunta? <a href="/preguntas-frecuentes">Ver todas</a> o <a href="/contacto">escríbenos</a>.</p>
      </div>
      <FaqList items={homeFaqs} />
    </div>
  </section>

  <!-- CTA -->
  <section class="section">
    <div class="wrap">
      <div class="navy cta" data-reveal>
        <div class="navy-grid" aria-hidden="true"></div>
        <div class="cta-copy">
          <h2>Mira Cumplido funcionando con un negocio como el tuyo.</h2>
          <p>Agenda una demostración. Revisamos cómo trabajas hoy y te enviamos una cotización sin compromiso.</p>
        </div>
        <div class="actions">
          <a class="btn btn--light" href="/contacto?motivo=demo">Solicitar demostración</a>
          <a class="btn btn--outline-light" href="/planes">Ver planes</a>
        </div>
      </div>
    </div>
  </section>
</Base>

<style>
  .hero { padding: var(--s-16) 0 var(--s-12); }
  .hero-in { position: relative; display: grid; grid-template-columns: minmax(0, .9fr) minmax(0, 1.1fr); gap: var(--s-16); align-items: center; }
  .copy { animation: rise 800ms var(--ease-out) both; }
  .flag { display: inline-flex; align-items: center; gap: 10px; font-size: var(--t-sm); color: #c9d8ee; border: 1px solid rgb(255 255 255 / 18%); border-radius: var(--r-full); padding: 7px 14px 7px 10px; margin-bottom: var(--s-6); }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: #2fd1ad; box-shadow: 0 0 0 0 rgb(47 209 173 / 60%); animation: pulse 2.4s ease-out 1s infinite; }
  @keyframes pulse { 70%, 100% { box-shadow: 0 0 0 10px transparent; } }
  .hero h1 { color: #fff; font-size: clamp(2.5rem, 5vw, 4.1rem); line-height: 1.02; letter-spacing: -.04em; font-weight: 800; max-width: 14ch; }
  .hero .lead { color: #b8cae4; margin-top: var(--s-6); max-width: 34rem; }
  .actions { display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-8); }
  .prods { list-style: none; display: flex; flex-wrap: wrap; gap: var(--s-3) var(--s-6); margin-top: var(--s-10); padding-top: var(--s-6); border-top: 1px solid rgb(255 255 255 / 12%); }
  .prod { display: flex; gap: 12px; align-items: center; text-decoration: none; color: #c9d8ee; font-size: var(--t-sm); line-height: 1.35; min-height: 44px; border-radius: var(--r-md); padding: 4px 8px 4px 4px; transition: background-color var(--dur-2); }
  .prod:hover { background: rgb(255 255 255 / 6%); }
  .prod strong { display: block; color: #fff; font-size: var(--t-base); }
  .pi { width: 42px; height: 42px; border-radius: var(--r-md); display: grid; place-items: center; flex: none; transition: transform var(--dur-3) var(--ease-spring); }
  .prod:hover .pi { transform: rotate(-8deg) scale(1.06); }
  .prod--salud .pi { background: rgb(47 209 173 / 14%); color: #2fd1ad; }
  .prod--belleza .pi { background: rgb(255 108 182 / 14%); color: #ff6cb6; }
  .disclaimer { position: relative; color: #8fa4c2; font-size: var(--t-xs); text-align: right; margin: var(--s-10) auto 0; }
  @keyframes rise { from { opacity: 0; transform: translateY(18px); } to { opacity: 1; transform: none; } }
  @media (max-width: 1100px) {
    .hero-in { grid-template-columns: minmax(0, 1fr); gap: var(--s-16); }
    .copy, .visual { max-width: 700px; }
    .disclaimer { text-align: left; }
  }
  @media (max-width: 520px) { .actions .btn { flex: 1 1 100%; } .hero { padding-top: var(--s-10); } }

  .section--flush { padding-top: 0; }
  .photos { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6); }
  @media (max-width: 800px) { .photos { grid-template-columns: minmax(0, 1fr); } }

  .admin { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.15fr); gap: var(--s-16); align-items: center; }
  .pill { display: inline-flex; font-size: var(--t-sm); font-weight: 700; color: var(--c-admin-ink); background: color-mix(in srgb, var(--c-admin) 12%, transparent); padding: 6px 12px; border-radius: var(--r-full); }
  .admin h2 { margin-top: var(--s-4); font-size: clamp(1.9rem, 3.2vw, 2.6rem); letter-spacing: -.035em; font-weight: 800; }
  .admin .lead { margin-bottom: var(--s-6); }
  .ticks { list-style: none; display: grid; gap: var(--s-3); margin-bottom: var(--s-4); }
  .ticks li { display: flex; gap: var(--s-3); align-items: flex-start; color: var(--ink-2); }
  .ticks :global(.ico) { width: 20px; height: 20px; margin-top: 2px; color: var(--c-admin-ink); }
  @media (max-width: 1000px) { .admin { grid-template-columns: minmax(0, 1fr); gap: var(--s-10); } }

  .center { text-align: center; margin-inline: auto; }
  .promo-line { margin-top: var(--s-6); color: var(--ink-2); text-align: center; }

  .trust { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-6); }
  .trust-col { padding: var(--s-8); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--surface); transition: box-shadow var(--dur-3), border-color var(--dur-2); }
  .trust-col:hover { border-color: var(--line-strong); box-shadow: var(--shadow-2); }
  .trust-col h3 { display: flex; gap: var(--s-3); align-items: center; margin-bottom: var(--s-5); }
  .trust-col h3 :global(.ico) { color: var(--c-brand); }
  .trust-col .ticks :global(.ico) { color: var(--c-health-ink); }
  .trust-links { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-6); margin-top: var(--s-6); }
  @media (max-width: 800px) { .trust { grid-template-columns: minmax(0, 1fr); } .trust-col { padding: var(--s-6); } }

  .faq-wrap { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.4fr); gap: var(--s-12); }
  @media (max-width: 900px) { .faq-wrap { grid-template-columns: minmax(0, 1fr); gap: 0; } }

  .cta { border-radius: 28px; padding: clamp(32px, 5vw, 64px); display: flex; flex-wrap: wrap; gap: var(--s-8); align-items: center; justify-content: space-between; }
  .cta > :not(.navy-grid) { position: relative; }
  .cta-copy { max-width: 560px; }
  .cta h2 { color: #fff; font-size: clamp(1.75rem, 3vw, 2.5rem); letter-spacing: -.035em; font-weight: 800; }
  .cta p { color: #b8cae4; margin: 0; font-size: var(--t-md); }
  .cta .actions { margin-top: 0; }
  @media (max-width: 520px) { .cta .actions { width: 100%; } }
</style>
