---
import Base from '../layouts/Base.astro';
import AgendaDemo from '../components/AgendaDemo.astro';
import Icon from '../components/Icon.astro';
import Logo from '../components/Logo.astro';
import Status from '../components/Status.astro';
import PlanCards from '../components/PlanCards.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import { solutionList } from '../data/solutions';
import features from '../data/features.json';
import faqs from '../data/faqs.json';
import promoData from '../data/promotions.json';
import { activePromotions, type Promotion } from '../lib/promotions';
import { company, has } from '../lib/company';

const adminGroup = features.groups.find((g) => g.id === 'operacion')!;
const homeFaqs = faqs.categories.flatMap((c) => c.items).filter((f) => 'home' in f && f.home);
const promos = activePromotions(promoData.promotions as Promotion[]);

const problems = [
  { now: 'Citas anotadas en un cuaderno, en el chat o en la memoria de alguien.', then: 'Una agenda por profesional y recordatorios automáticos para que nadie olvide su cita.' },
  { now: 'Los datos de cada paciente o cliente repartidos en varias hojas.', then: 'Una ficha por persona con su historial, sus citas y sus pagos.' },
  { now: 'Insumos y productos que se acaban o vencen sin aviso.', then: 'Inventario que descuenta lo que se usa y avisa qué reponer.' },
  { now: 'Abonos y saldos que nadie sabe cuánto suman.', then: 'Caja y cartera al día, con lo que debe cada quien.' },
  { now: 'Comisiones y turnos calculados a mano a fin de mes.', then: 'Turnos y comisiones calculados con lo que se hizo y cobró.' },
  { now: 'Las cuentas del negocio en otro programa, o en ninguno.', then: 'La contabilidad se alimenta sola desde la operación diaria.' },
];

const steps = [
  { title: 'Elige tu software', text: 'Cumplido Salud para consultorios, Cumplido Belleza para salones.' },
  { title: 'Agenda la demostración', text: 'Te mostramos el software con ejemplos de un negocio como el tuyo.' },
  { title: 'Recibe tu cotización', text: 'Plan, usuarios, módulos y condiciones por escrito, antes de pagar nada.' },
  { title: 'Configuramos tu negocio', text: 'Servicios, precios, profesionales, horarios y permisos.' },
  { title: 'Empieza a cumplir', text: 'Agenda, atención, caja y cuentas desde el primer día.' },
];

const jsonLd = [
  { '@context': 'https://schema.org', '@type': 'Organization', name: company.brandName, ...(has(company.siteUrl) ? { url: company.siteUrl, logo: new URL('/brand/cumplido-marca.svg', company.siteUrl).href } : {}) },
  ...solutionList.map((s) => ({
    '@context': 'https://schema.org',
    '@type': 'SoftwareApplication',
    name: s.name,
    applicationCategory: 'BusinessApplication',
    operatingSystem: 'Web, Android, iOS',
    description: s.seoDescription,
    inLanguage: 'es-CO',
  })),
];
---
<Base
  title="Software para consultorios y salones de belleza"
  description="Cumplido es el software de gestión para negocios de salud y de belleza en Colombia: Cumplido Salud para consultorios de odontología y fisioterapia, y Cumplido Belleza para peluquerías, barberías y salones. Agenda, atención, administración y contabilidad incluidas."
  jsonLd={jsonLd}
>
  <!-- Hero -->
  <section class="hero">
    <div class="hero-bg" aria-hidden="true"></div>
    <div class="wrap hero-in">
      <div class="hero-copy">
        <p class="hero-flag"><span class="pulse" aria-hidden="true"></span>En desarrollo: pide una demostración</p>
        <h1>Citas a tiempo, clientes que vuelven y cuentas claras</h1>
        <p class="lead">Cumplido es el software que tu consultorio o tu salón necesita para trabajar en orden. Elige el tuyo: cada uno trae la agenda, la atención y toda la administración y contabilidad.</p>
        <div class="pick" role="group" aria-label="Elige tu software">
          {solutionList.map((s) => (
            <a class="pick-card" href={`/soluciones/${s.id}`} style={`--accent:${s.accent}`} data-pick={s.id}>
              <Logo product={s.id} size={34} />
              <span class="pick-for">{s.pitch}</span>
              <span class="pick-go">Ver {s.name}</span>
            </a>
          ))}
        </div>
        <div class="hero-actions">
          <a class="btn" href="/contacto?motivo=demo">Solicitar demostración</a>
          <a class="btn btn--ghost" href="/planes">Ver planes</a>
        </div>
      </div>
      <div class="hero-visual">
        <div class="seg" role="group" aria-label="Ver ejemplo de">
          {solutionList.map((s, i) => (
            <button type="button" aria-pressed={i === 0 ? 'true' : 'false'} aria-controls={`demo-${s.id}`} data-demo-tab={s.id} style={`--accent:${s.accent}`}>{s.name}</button>
          ))}
        </div>
        <AgendaDemo variant="salud" />
        <AgendaDemo variant="belleza" hidden />
      </div>
    </div>
  </section>

  <!-- Dos software -->
  <section class="section section--surface" aria-labelledby="prod-t">
    <div class="wrap">
      <div class="section-head">
        <h2 id="prod-t">Dos software, cada uno hecho para su negocio</h2>
        <p>Un consultorio no trabaja como un salón. Por eso Cumplido no es un sistema genérico: cada software habla el idioma de tu negocio y trae lo que necesitas desde el primer día.</p>
      </div>
      <div class="products">
        {solutionList.map((s) => (
          <article class="product" style={`--accent:${s.accent};--accent-ink:${s.accentInk}`} aria-labelledby={`p-${s.id}`}>
            <header>
              <Logo product={s.id} size={44} />
              <h3 id={`p-${s.id}`} class="sr-only">{s.name}</h3>
              <p class="for">{s.audience.join(', ')}</p>
            </header>
            <p class="p-head">{s.headline}</p>
            <ul class="checks">
              {s.highlights.map((h) => <li><Icon name="Check" />{h}</li>)}
            </ul>
            <div class="p-actions">
              <a class="btn" href={`/contacto?motivo=demo&producto=${s.id}`}>Pedir demo de {s.name}</a>
              <a class="p-link" href={`/soluciones/${s.id}`}>Conocer {s.name}</a>
            </div>
          </article>
        ))}
      </div>
    </div>
  </section>

  <!-- Problemas -->
  <section class="section" aria-labelledby="problemas-t">
    <div class="wrap problems">
      <div class="section-head sticky-head">
        <h2 id="problemas-t">Lo que cambia cuando trabajas con Cumplido</h2>
        <p>Cuando la agenda, los pagos y las cuentas viven en lugares distintos, el equipo pierde tiempo y el dueño decide sin números.</p>
      </div>
      <div class="pairs" role="table" aria-label="Antes y con Cumplido">
        <div class="pairs-head" role="row">
          <span role="columnheader">Antes</span>
          <span role="columnheader">Con Cumplido</span>
        </div>
        {problems.map((p) => (
          <div class="pair" role="row">
            <p role="cell" class="p-now">{p.now}</p>
            <p role="cell" class="p-then"><Icon name="Check" />{p.then}</p>
          </div>
        ))}
      </div>
    </div>
  </section>

  <!-- Administración incluida -->
  <section class="section admin" aria-labelledby="admin-t">
    <div class="wrap">
      <div class="section-head row-head">
        <div>
          <h2 id="admin-t">Administración y contabilidad completas, incluidas</h2>
          <p>No compras un programa contable aparte. Cumplido Salud y Cumplido Belleza traen la parte administrativa y contable: lo que pasa en la agenda queda registrado en caja, inventario y cuentas.</p>
        </div>
        <a class="btn btn--ghost" href="/soluciones/administracion">Ver qué incluye</a>
      </div>
      <ul class="feat-grid">
        {adminGroup.items.slice(0, 9).map((f) => (
          <li class="feat">
            <span class="feat-ico"><Icon name={f.icon} /></span>
            <div>
              <div class="feat-top"><h3>{f.title}</h3><Status status={f.status} /></div>
              <p>{f.text}</p>
            </div>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <!-- Cómo empiezas -->
  <section class="section section--surface" aria-labelledby="como-t">
    <div class="wrap">
      <div class="section-head">
        <h2 id="como-t">Cómo empiezas</h2>
        <p>De la primera conversación al uso diario, en cinco pasos.</p>
      </div>
      <ol class="steps">
        {steps.map((s, i) => (
          <li>
            <span class="step-n" aria-hidden="true">{i + 1}</span>
            <h3>{s.title}</h3>
            <p>{s.text}</p>
          </li>
        ))}
      </ol>
    </div>
  </section>

  <!-- Planes -->
  <section class="section" aria-labelledby="planes-t">
    <div class="wrap">
      <div class="section-head row-head">
        <div>
          <h2 id="planes-t">Planes según el tamaño de tu equipo</h2>
          <p>Los mismos tres planes para Cumplido Salud y Cumplido Belleza. La suscripción es mensual y los precios se entregan por cotización.</p>
        </div>
        <a class="btn btn--ghost" href="/planes">Comparar planes</a>
      </div>
      <PlanCards />
      <p class="promo-line small">
        {promos.length > 0
          ? <>Hay {promos.length === 1 ? 'una promoción vigente' : `${promos.length} promociones vigentes`}. <a href="/promociones">Ver condiciones</a></>
          : <>No hay promociones vigentes en este momento. <a href="/promociones">Ver promociones</a></>}
      </p>
    </div>
  </section>

  <!-- Confianza -->
  <section class="section section--surface" aria-labelledby="seg-t">
    <div class="wrap">
      <div class="section-head">
        <h2 id="seg-t">Cómo cuidamos tu información</h2>
        <p>Separamos lo que ya aplicamos en este sitio de lo que estamos construyendo en el software. No declaramos certificaciones que no tenemos.</p>
      </div>
      <div class="trust">
        <div class="trust-col">
          <h3><Icon name="Monitor" />En este sitio</h3>
          <ul class="checks">
            <li><Icon name="Check" />Sin cookies de analítica, publicidad ni herramientas de terceros.</li>
            <li><Icon name="Check" />El formulario pide solo los datos necesarios para responderte.</li>
            <li><Icon name="Check" />Recibir publicidad es opcional y va en una casilla aparte.</li>
            <li><Icon name="Check" />Nunca pedimos información de salud en formularios públicos.</li>
          </ul>
        </div>
        <div class="trust-col">
          <h3><Icon name="ShieldCheck" />En el software (en desarrollo)</h3>
          <ul class="checks">
            <li><Icon name="Check" />Usuarios con permisos por rol, módulo y función.</li>
            <li><Icon name="Check" />La historia clínica solo la ve quien tiene permiso clínico.</li>
            <li><Icon name="Check" />La información de cada negocio separada de la de los demás.</li>
            <li><Icon name="Check" />Comunicación cifrada y copias de seguridad.</li>
          </ul>
        </div>
      </div>
      <p class="trust-links small">
        <a href="/legal/seguridad">Seguridad y reporte de incidentes</a>
        <a href="/legal/tratamiento-de-datos">Tratamiento de datos personales</a>
        <a href="/legal/tratamiento-por-encargo">Datos de tus pacientes y clientes</a>
      </p>
    </div>
  </section>

  <!-- FAQ -->
  <section class="section" aria-labelledby="faq-t">
    <div class="wrap faq-wrap">
      <div class="section-head">
        <h2 id="faq-t">Preguntas frecuentes</h2>
        <p>¿No encuentras tu pregunta? <a href="/preguntas-frecuentes">Ver todas</a> o <a href="/contacto">escríbenos</a>.</p>
      </div>
      <FaqList items={homeFaqs} />
    </div>
  </section>

  <CtaBand title="Mira Cumplido funcionando con un negocio como el tuyo" />
</Base>

<style>
  /* Hero */
  .hero { position: relative; padding: var(--s-16) 0 var(--s-24); overflow: hidden; }
  .hero-bg {
    position: absolute; inset: 0; z-index: 0; pointer-events: none;
    background-image: linear-gradient(var(--line) 1px, transparent 1px), linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 96px 48px; background-position: -1px -1px;
    mask-image: radial-gradient(ellipse 70% 80% at 75% 40%, #000 0%, transparent 75%);
    opacity: .55;
  }
  .hero-in { position: relative; z-index: 1; display: grid; grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr); gap: var(--s-16); align-items: center; }
  .hero-copy { animation: rise .7s cubic-bezier(.2, .8, .2, 1) both; }
  .hero h1 { max-width: 15ch; font-size: clamp(2.25rem, 4.4vw, 3.6rem); }
  .hero-flag { display: inline-flex; align-items: center; gap: 10px; font-size: var(--t-sm); color: var(--ink-2); background: var(--surface); border: 1px solid var(--line); border-radius: 999px; padding: 6px 14px 6px 10px; margin-bottom: var(--s-6); }
  .pulse { width: 8px; height: 8px; border-radius: 50%; background: var(--c-health); box-shadow: 0 0 0 0 color-mix(in srgb, var(--c-health) 60%, transparent); animation: pulse 2.4s ease-out 1s 3; }
  @keyframes pulse { to { box-shadow: 0 0 0 10px transparent; } }
  .pick { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-3); margin: var(--s-8) 0 var(--s-6); }
  .pick-card {
    display: flex; flex-direction: column; gap: var(--s-2); padding: var(--s-4) var(--s-4) var(--s-4) var(--s-5); border-radius: var(--r-lg);
    background: var(--surface); border: 1px solid var(--line); text-decoration: none; color: var(--ink); position: relative;
    transition: border-color .2s, box-shadow .2s, transform .2s;
  }
  .pick-card::before { content: ''; position: absolute; left: -1px; top: 14px; bottom: 14px; width: 3px; border-radius: 3px; background: var(--accent); }
  .pick-card:hover { border-color: var(--accent); box-shadow: var(--shadow-2); transform: translateY(-2px); }
  .pick-card :global(.logo-text) { font-size: 1.15rem; }
  .pick-for { font-size: var(--t-sm); color: var(--ink-2); line-height: 1.4; }
  .pick-go { font-size: var(--t-sm); font-weight: 600; color: var(--c-brand); text-decoration: underline; text-underline-offset: 3px; }
  .hero-actions { display: flex; gap: var(--s-3); flex-wrap: wrap; }
  .hero-visual { animation: rise .8s cubic-bezier(.2, .8, .2, 1) .15s both; }
  .seg { display: inline-flex; gap: 4px; padding: 4px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); margin-bottom: var(--s-5); }
  .seg button { font: 600 var(--t-sm)/1 var(--font); border: 0; background: transparent; color: var(--ink-2); padding: 9px 14px; border-radius: 999px; cursor: pointer; }
  .seg button[aria-pressed='true'] { background: color-mix(in srgb, var(--accent) 15%, var(--surface)); color: var(--ink); box-shadow: inset 0 0 0 1px var(--accent); }
  @keyframes rise { from { opacity: 0; transform: translateY(16px); } to { opacity: 1; transform: none; } }
  @media (max-width: 1000px) { .hero-in { grid-template-columns: 1fr; gap: var(--s-12); } .hero { padding-bottom: var(--s-20); } }
  @media (max-width: 520px) { .pick { grid-template-columns: 1fr; } }

  /* Productos */
  .products { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-6); }
  .product { display: flex; flex-direction: column; gap: var(--s-5); padding: var(--s-10); border-radius: var(--r-xl); background: var(--bg); border: 1px solid var(--line); border-top: 5px solid var(--accent); }
  .product header { display: flex; flex-direction: column; gap: var(--s-3); }
  .product :global(.logo-text) { font-size: 1.75rem; }
  .for { margin: 0; font-size: var(--t-sm); font-weight: 600; color: var(--accent-ink); }
  .p-head { font-size: var(--t-lg); font-weight: 650; letter-spacing: -0.015em; line-height: 1.3; margin: 0; color: var(--ink); }
  .product .checks { flex: 1; }
  .product .checks :global(.ico) { color: var(--accent-ink); }
  .p-actions { display: flex; flex-wrap: wrap; gap: var(--s-4); align-items: center; }
  .p-link { font-weight: 600; }
  @media (max-width: 900px) { .products { grid-template-columns: 1fr; } .product { padding: var(--s-6); } }

  .checks { list-style: none; display: grid; gap: var(--s-3); }
  .checks li { display: flex; gap: var(--s-3); align-items: flex-start; color: var(--ink-2); }
  .checks :global(.ico) { width: 20px; height: 20px; margin-top: 2px; color: var(--accent, var(--c-brand)); }

  /* Problemas */
  .problems { display: grid; grid-template-columns: minmax(0, .85fr) minmax(0, 1.4fr); gap: var(--s-12); align-items: start; }
  .sticky-head { position: sticky; top: calc(var(--header-h) + 24px); }
  .pairs-head, .pair { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-6); }
  .pairs-head { font-size: var(--t-sm); font-weight: 650; color: var(--ink-3); padding-bottom: var(--s-3); border-bottom: 2px solid var(--ink); }
  .pairs-head span:last-child { color: var(--c-brand); }
  .pair { padding: var(--s-5) 0; border-bottom: 1px solid var(--line); }
  .pair p { margin: 0; }
  .p-now { color: var(--ink-3); }
  .p-then { display: flex; gap: var(--s-3); color: var(--ink); font-weight: 500; }
  .p-then :global(.ico) { width: 20px; height: 20px; color: var(--c-health-ink); margin-top: 3px; flex: none; }
  @media (max-width: 900px) { .problems { grid-template-columns: 1fr; gap: var(--s-6); } .sticky-head { position: static; } }
  @media (max-width: 560px) { .pairs-head { display: none; } .pair { grid-template-columns: 1fr; gap: var(--s-2); } .p-now::before { content: 'Antes: '; font-weight: 600; } }

  /* Administración */
  .admin { border-top: 1px solid var(--line); }
  .row-head { max-width: none; display: flex; justify-content: space-between; align-items: flex-end; gap: var(--s-6); flex-wrap: wrap; }
  .row-head > div { max-width: 680px; }
  .row-head p { margin-bottom: 0; }
  .feat-grid { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); border-top: 1px solid var(--line); border-left: 1px solid var(--line); }
  .feat { display: flex; gap: var(--s-4); padding: var(--s-6); border-right: 1px solid var(--line); border-bottom: 1px solid var(--line); background: var(--surface); }
  .feat-ico { width: 40px; height: 40px; border-radius: 10px; display: grid; place-items: center; flex: none; background: color-mix(in srgb, var(--c-admin) 12%, transparent); color: var(--c-admin-ink); }
  .feat-top { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-3); align-items: center; margin-bottom: var(--s-2); }
  .feat h3 { margin: 0; font-size: var(--t-base); }
  .feat p { margin: 0; color: var(--ink-2); font-size: var(--t-sm); }
  @media (max-width: 1000px) { .feat-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); } }
  @media (max-width: 640px) { .feat-grid { grid-template-columns: 1fr; } }

  /* Pasos */
  .steps { list-style: none; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--s-6); position: relative; }
  .steps::before { content: ''; position: absolute; top: 20px; left: 20px; right: 10%; height: 2px; background: linear-gradient(90deg, var(--c-health), var(--c-brand), var(--c-beauty)); opacity: .5; }
  .steps li { position: relative; }
  .step-n { position: relative; display: grid; place-items: center; width: 42px; height: 42px; border-radius: 50%; background: var(--surface); border: 2px solid var(--c-brand); color: var(--c-brand); font-weight: 750; margin-bottom: var(--s-5); }
  .steps h3 { font-size: var(--t-base); margin-bottom: var(--s-2); }
  .steps p { color: var(--ink-2); font-size: var(--t-sm); margin: 0; }
  @media (max-width: 900px) {
    .steps { grid-template-columns: 1fr; gap: 0; }
    .steps::before { top: 0; bottom: 0; left: 20px; right: auto; width: 2px; height: auto; background: linear-gradient(var(--c-health), var(--c-brand), var(--c-beauty)); }
    .steps li { padding: 0 0 var(--s-8) 64px; }
    .step-n { position: absolute; left: 0; top: -6px; }
  }

  .promo-line { margin-top: var(--s-6); color: var(--ink-2); }

  .trust { display: grid; grid-template-columns: 1fr 1fr; gap: var(--s-6); }
  .trust-col { padding: var(--s-8); border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--bg); }
  .trust-col h3 { display: flex; gap: var(--s-3); align-items: center; margin-bottom: var(--s-5); }
  .trust-col h3 :global(.ico) { color: var(--c-brand); }
  .trust-col:last-child { --accent: var(--c-health-ink); }
  .trust-links { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-6); margin-top: var(--s-6); }
  @media (max-width: 800px) { .trust { grid-template-columns: 1fr; } .trust-col { padding: var(--s-6); } }

  .faq-wrap { display: grid; grid-template-columns: minmax(0, .8fr) minmax(0, 1.4fr); gap: var(--s-12); }
  @media (max-width: 900px) { .faq-wrap { grid-template-columns: 1fr; gap: 0; } }
</style>

<script>
  // Cambia el ejemplo del hero entre Cumplido Salud y Cumplido Belleza.
  const tabs = Array.from(document.querySelectorAll<HTMLButtonElement>('[data-demo-tab]'));
  const select = (t: HTMLButtonElement) => {
    tabs.forEach((b) => {
      const on = b === t;
      b.setAttribute('aria-pressed', String(on));
      document.getElementById(b.getAttribute('aria-controls')!)!.hidden = !on;
    });
  };
  tabs.forEach((t) => t.addEventListener('click', () => select(t)));
  // Al pasar el cursor por una tarjeta de producto, el ejemplo muestra ese software.
  document.querySelectorAll<HTMLElement>('[data-pick]').forEach((c) => {
    c.addEventListener('mouseenter', () => {
      const t = tabs.find((b) => b.dataset.demoTab === c.dataset.pick);
      if (t) select(t);
    });
  });
</script>
