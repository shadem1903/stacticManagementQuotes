---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Logo from '../../components/Logo.astro';
import CtaBand from '../../components/CtaBand.astro';
import { solutionList } from '../../data/solutions';

const shared = [
  { icon: 'CalendarDays', t: 'Agenda y recordatorios' },
  { icon: 'Smartphone', t: 'App para tus pacientes o clientes' },
  { icon: 'Wallet', t: 'Caja, pagos y cartera' },
  { icon: 'Boxes', t: 'Inventario y compras' },
  { icon: 'Calculator', t: 'Contabilidad' },
  { icon: 'ChartColumn', t: 'Reportes' },
];
---
<Base title="Elige tu software" description="Cumplido Salud para consultorios de odontología, fisioterapia y bienestar. Cumplido Belleza para peluquerías, barberías y salones. Los dos incluyen administración y contabilidad.">
  <PageHero
    title="Elige el software de tu negocio"
    lead="Dos software, cada uno hecho para un tipo de negocio. Los dos traen agenda, app para tus clientes y toda la administración y contabilidad."
    crumbs={[{ href: '/soluciones', label: 'Software' }]}
  />
  <section class="section">
    <div class="wrap">
      <div class="sols">
        {solutionList.map((s) => (
          <a class="sol" href={`/soluciones/${s.id}`} style={`--accent:${s.accent};--accent-ink:${s.accentInk}`}>
            <Logo product={s.id} size={44} />
            <p class="for">{s.pitch}</p>
            <p class="head">{s.headline}</p>
            <ul>{s.highlights.map((h) => <li><Icon name="Check" />{h}</li>)}</ul>
            <span class="more">Conocer {s.name}</span>
          </a>
        ))}
      </div>
    </div>
  </section>
  <section class="section section--surface" aria-labelledby="base-t">
    <div class="wrap">
      <div class="section-head">
        <h2 id="base-t">Incluido en los dos</h2>
        <p>La base que todo negocio de atención necesita. <a href="/soluciones/administracion">Ver la administración y contabilidad incluidas</a>.</p>
      </div>
      <ul class="shared">
        {shared.map((x) => <li><Icon name={x.icon} />{x.t}</li>)}
      </ul>
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .sols { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: var(--s-6); }
  .sol { display: flex; flex-direction: column; gap: var(--s-4); padding: var(--s-10); background: var(--surface); border: 1px solid var(--line); border-top: 5px solid var(--accent); border-radius: var(--r-xl); color: var(--ink); text-decoration: none; transition: box-shadow .2s, transform .2s; }
  .sol:hover { box-shadow: var(--shadow-2); transform: translateY(-2px); }
  .sol :global(.logo-text) { font-size: 1.75rem; }
  .for { margin: 0; font-weight: 600; font-size: var(--t-sm); color: var(--accent-ink); }
  .head { margin: 0; font-size: var(--t-lg); font-weight: 650; letter-spacing: -0.015em; line-height: 1.3; }
  .sol ul { list-style: none; display: grid; gap: var(--s-2); color: var(--ink-2); font-size: var(--t-sm); flex: 1; }
  .sol li { display: flex; gap: var(--s-2); }
  .sol li :global(.ico) { width: 18px; height: 18px; color: var(--accent-ink); margin-top: 2px; }
  .more { font-weight: 600; color: var(--c-brand); text-decoration: underline; text-underline-offset: 3px; }
  .shared { list-style: none; display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: var(--s-3); }
  .shared li { display: flex; gap: var(--s-3); align-items: center; padding: var(--s-4) var(--s-5); border: 1px solid var(--line); border-radius: var(--r-md); background: var(--bg); font-weight: 600; }
  .shared :global(.ico) { color: var(--c-brand); }
  @media (max-width: 900px) { .sols { grid-template-columns: 1fr; } .sol { padding: var(--s-6); } .shared { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 520px) { .shared { grid-template-columns: 1fr; } }
</style>
