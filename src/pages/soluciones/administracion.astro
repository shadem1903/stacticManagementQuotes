---
import Base from '../../layouts/Base.astro';
import PageHero from '../../components/PageHero.astro';
import Icon from '../../components/Icon.astro';
import Logo from '../../components/Logo.astro';
import Status from '../../components/Status.astro';
import FaqList from '../../components/FaqList.astro';
import CtaBand from '../../components/CtaBand.astro';
import features from '../../data/features.json';
import { solutionList } from '../../data/solutions';

const admin = features.groups.find((g) => g.id === 'operacion')!;
const flow = [
  { t: 'Se atiende la cita', d: 'El profesional marca el servicio o procedimiento como hecho.' },
  { t: 'Se descuenta el inventario', d: 'Los insumos o productos usados salen del stock.' },
  { t: 'Se cobra', d: 'El pago o abono entra a caja y, si queda saldo, a cartera.' },
  { t: 'Se registra en contabilidad', d: 'El ingreso queda contabilizado sin volver a digitarlo.' },
  { t: 'Se ve en los reportes', d: 'Ventas, utilidad, ocupación y comisiones al día.' },
];
const faqs = [
  { q: '¿Es un software aparte?', a: 'No. La administración y la contabilidad vienen dentro de Cumplido Salud y de Cumplido Belleza, en todos los planes.' },
  { q: '¿Mi contador puede entrar?', a: 'Sí. El rol de contador consulta caja, gastos, cartera y contabilidad. En Cumplido Salud no tiene acceso a las historias clínicas.' },
  { q: '¿Emite facturación electrónica?', a: 'Está planeada mediante un proveedor tecnológico autorizado por la DIAN. Hasta que esté disponible, Cumplido no emite facturas electrónicas.' },
  { q: '¿Reemplaza a mi contador?', a: 'No. Cumplido organiza y registra la información del negocio; la asesoría contable y tributaria sigue siendo de un profesional.' },
];
---
<Base title="Administración y contabilidad incluidas" description="Caja, pagos, cartera, gastos, inventario, personal, reportes y contabilidad incluidos en Cumplido Salud y Cumplido Belleza, sin software aparte.">
  <PageHero
    title="La administración y la contabilidad ya vienen incluidas"
    lead="No necesitas otro programa para las cuentas. Cumplido Salud y Cumplido Belleza traen la parte administrativa y contable completa, alimentada por lo que pasa cada día en tu agenda."
    accent="var(--c-admin)"
    crumbs={[{ href: '/soluciones', label: 'Software' }, { href: '/soluciones/administracion', label: 'Administración y contabilidad' }]}
  >
    <ul class="in" aria-label="Incluida en">
      {solutionList.map((s) => <li><a href={`/soluciones/${s.id}`}><Logo product={s.id} size={26} /></a></li>)}
    </ul>
  </PageHero>

  <section class="section" aria-labelledby="flow-t">
    <div class="wrap">
      <div class="section-head"><h2 id="flow-t">Una cita, cinco registros, cero digitación doble</h2></div>
      <ol class="flow">
        {flow.map((f, i) => <li><span class="n" aria-hidden="true">{i + 1}</span><h3>{f.t}</h3><p>{f.d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="section section--surface" aria-labelledby="inc-t">
    <div class="wrap">
      <div class="section-head"><h2 id="inc-t">Qué incluye</h2><p>Con el estado real de cada módulo.</p></div>
      <ul class="flist">
        {admin.items.map((f) => (
          <li><span class="fi"><Icon name={f.icon} /></span><div><div class="ft"><h3>{f.title}</h3><Status status={f.status} /></div><p>{f.text}</p></div></li>
        ))}
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="faq-t">
    <div class="wrap">
      <div class="section-head"><h2 id="faq-t">Preguntas sobre administración y contabilidad</h2></div>
      <FaqList items={faqs} />
    </div>
  </section>
  <CtaBand />
</Base>
<style>
  .in { list-style: none; display: flex; flex-wrap: wrap; gap: var(--s-3); margin-top: var(--s-4); }
  .in a { display: inline-flex; padding: 8px 14px 8px 8px; border-radius: 999px; background: var(--surface); border: 1px solid var(--line); text-decoration: none; }
  .in :global(.logo-text) { font-size: 1.05rem; }
  .flow { list-style: none; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); gap: var(--s-4); counter-reset: n; }
  .flow li { padding: var(--s-5); background: var(--surface); border: 1px solid var(--line); border-radius: var(--r-lg); }
  .n { display: grid; place-items: center; width: 32px; height: 32px; border-radius: 50%; border: 2px solid var(--c-admin); color: var(--ink); font-weight: 700; font-size: var(--t-sm); margin-bottom: var(--s-4); }
  .flow h3 { font-size: var(--t-base); margin-bottom: var(--s-2); }
  .flow p { margin: 0; font-size: var(--t-sm); color: var(--ink-2); }
  .flist { list-style: none; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 0 var(--s-10); }
  .flist li { display: flex; gap: var(--s-4); padding: var(--s-5) 0; border-bottom: 1px solid var(--line); }
  .fi { width: 40px; height: 40px; flex: none; border-radius: 10px; display: grid; place-items: center; color: var(--c-admin-ink); background: color-mix(in srgb, var(--c-admin) 12%, transparent); }
  .ft { display: flex; flex-wrap: wrap; gap: var(--s-2) var(--s-3); align-items: center; margin-bottom: 4px; }
  .ft h3 { margin: 0; font-size: var(--t-base); }
  .flist p { margin: 0; color: var(--ink-2); font-size: var(--t-sm); }
  @media (max-width: 1000px) { .flow { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 800px) { .flist { grid-template-columns: 1fr; } }
  @media (max-width: 520px) { .flow { grid-template-columns: 1fr; } }
</style>
