---
import Base from '../layouts/Base.astro';
import PageHero from '../components/PageHero.astro';
import PlanCards from '../components/PlanCards.astro';
import FaqList from '../components/FaqList.astro';
import CtaBand from '../components/CtaBand.astro';
import data from '../data/plans.json';
import faqs from '../data/faqs.json';

const rows: { label: string; values: string[] }[] = [
  { label: 'Precio', values: data.plans.map((p) => (p.price == null ? 'Cotización' : String(p.price))) },
  { label: 'Periodicidad', values: data.plans.map(() => 'Mensual') },
  { label: 'Usuarios', values: data.plans.map((p) => (p.users.max ? `${p.users.min} a ${p.users.max}` : `${p.users.min} o más`)) },
  { label: 'Módulos', values: ['Esenciales', 'Todos los disponibles', 'Todos los disponibles'] },
  { label: 'Reportes avanzados', values: ['No', 'No', 'Sí'] },
  { label: 'Soporte', values: data.plans.map((p) => p.support) },
  { label: 'Impuestos y cargos', values: data.plans.map(() => 'Se detallan en la cotización') },
];
const planFaqs = faqs.categories.find((c) => c.id === 'contratacion')!.items;
---
<Base title="Planes y precios" description="Planes Básico, Profesional y Empresarial de Cumplido Salud y Cumplido Belleza según el número de usuarios. Precios por cotización personalizada, suscripción mensual.">
  <PageHero
    title="Planes según el tamaño de tu equipo"
    lead="Los mismos tres planes para Cumplido Salud y Cumplido Belleza. El plan define cuántos usuarios pueden entrar y qué módulos están habilitados; la administración y la contabilidad vienen en todos."
    crumbs={[{ href: '/planes', label: 'Planes' }]}
  >
    <div class="notice notice--info" role="note">
      <p><strong>Precios por cotización.</strong> Aún no publicamos tarifas fijas. Esta página es informativa: no permite comprar ni pagar en línea. Toda contratación se formaliza con una cotización escrita que incluye precio, impuestos y condiciones.</p>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap"><PlanCards detailed /></div>
  </section>

  <section class="section section--surface" aria-labelledby="cmp-t">
    <div class="wrap">
      <div class="section-head"><h2 id="cmp-t">Comparación de planes</h2></div>
      <div class="table-wrap" tabindex="0" role="region" aria-labelledby="cmp-t">
        <table>
          <thead>
            <tr><th scope="col"><span class="sr-only">Característica</span></th>{data.plans.map((p) => <th scope="col">{p.name}</th>)}</tr>
          </thead>
          <tbody>
            {rows.map((r) => (<tr><th scope="row">{r.label}</th>{r.values.map((v) => <td>{v}</td>)}</tr>))}
          </tbody>
        </table>
      </div>
      <h3 class="terms-t">Condiciones comunes</h3>
      <ul class="terms">
        {data.commonTerms.map((t) => <li>{t}</li>)}
        <li>Consulta las <a href="/legal/servicio-saas">condiciones del servicio</a> y la política de <a href="/legal/cancelaciones-y-reembolsos">cancelaciones y reembolsos</a>.</li>
      </ul>
    </div>
  </section>

  <section class="section" aria-labelledby="pf-t">
    <div class="wrap">
      <div class="section-head"><h2 id="pf-t">Preguntas sobre planes</h2></div>
      <FaqList items={planFaqs} />
    </div>
  </section>
  <CtaBand title="Pide la cotización para tu negocio" text="Indícanos cuántas personas usarán Cumplido y qué software necesitas necesitas. Te respondemos con una propuesta escrita." />
</Base>
<style>
  .notice { margin-top: var(--s-6); max-width: 760px; }
  .table-wrap { overflow-x: auto; border: 1px solid var(--line); border-radius: var(--r-lg); background: var(--bg); }
  table { width: 100%; border-collapse: collapse; min-width: 620px; font-size: var(--t-sm); }
  th, td { padding: var(--s-4) var(--s-5); text-align: left; border-bottom: 1px solid var(--line); }
  thead th { font-size: var(--t-base); color: var(--ink); background: var(--surface); }
  tbody th { color: var(--ink-2); font-weight: 600; width: 24%; }
  tbody tr:last-child > * { border-bottom: 0; }
  .terms-t { margin-top: var(--s-10); }
  .terms { padding-left: 1.2em; color: var(--ink-2); display: grid; gap: var(--s-2); max-width: 760px; }
</style>
